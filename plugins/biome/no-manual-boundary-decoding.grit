engine biome(1.0)
language js(typescript, jsx)

or {
  `typeof $value === "object"` as $match where {
    register_diagnostic(span=$match, message="Manual object decoding is forbidden in boundary code. Use Schema.decodeUnknownEffect(MySchema)(value) in Effect flows, Schema.decodeUnknownOption(MySchema)(value) for branch checks, Schema.fromJsonString(MySchema) for JSON strings, or z.safeParse(value). Add biome-ignore only with a reason.", severity="error")
  },
  `typeof $value !== "object"` as $match where {
    register_diagnostic(span=$match, message="Manual object decoding is forbidden in boundary code. Use Schema.decodeUnknownEffect(MySchema)(value) in Effect flows, Schema.decodeUnknownOption(MySchema)(value) for branch checks, Schema.fromJsonString(MySchema) for JSON strings, or z.safeParse(value). Add biome-ignore only with a reason.", severity="error")
  },
  `$field in $value` as $match where {
    $value <: or {
      `decoded`,
      `error`,
      `cause`,
      `payload`,
      `value`,
      `body`,
      `response`
    },
    register_diagnostic(span=$match, message="Manual field-existence checks on boundary payloads are forbidden. Define a Schema.Struct/Zod object and decode the value instead. Add biome-ignore only with a reason.", severity="error")
  },
  `typeof $value.$field === "string"` as $match where {
    $value <: or {
      `decoded`,
      `error`,
      `cause`,
      `payload`,
      `value`,
      `body`,
      `response`
    },
    register_diagnostic(span=$match, message="Manual field type checks on boundary payloads are forbidden. Put the field in Schema.Struct({ field: Schema.String }) or a Zod object and decode once.", severity="error")
  },
  `typeof $value.$field !== "string"` as $match where {
    $value <: or {
      `decoded`,
      `error`,
      `cause`,
      `payload`,
      `value`,
      `body`,
      `response`
    },
    register_diagnostic(span=$match, message="Manual field type checks on boundary payloads are forbidden. Put the field in Schema.Struct({ field: Schema.String }) or a Zod object and decode once.", severity="error")
  }
}
