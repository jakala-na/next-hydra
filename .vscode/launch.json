{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev"
    },
    {
      "name": "Next.js: debug client-side (docs)",
      "type": "chrome",
      "request": "launch",
      "url": "https://docs.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug client-side (web)",
      "type": "chrome",
      "request": "launch",
      "url": "https://web.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug client-side (api)",
      "type": "chrome",
      "request": "launch",
      "url": "https://api.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug client-side (email)",
      "type": "chrome",
      "request": "launch",
      "url": "https://email.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug client-side (storybook)",
      "type": "chrome",
      "request": "launch",
      "url": "https://storybook.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug client-side (admin)",
      "type": "chrome",
      "request": "launch",
      "url": "https://admin.next-hydra.localhost"
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithEdge",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
