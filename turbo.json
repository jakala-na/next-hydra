{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "test"],
      "outputs": [
        ".next/**",
        "!**/node_modules/**",
        "!**/.next/dev/**",
        "!**/.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**"
      ]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "canvas:registry": {},
    "boundaries": {},
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:public": {
      "cache": false,
      "persistent": true
    },
    "deploy:acquia": {
      "cache": false,
      "passThroughEnv": [
        "ACQUIA_ENVIRONMENT_ALIAS",
        "COMPOSER_MEMORY_LIMIT",
        "SSH_AUTH_SOCK"
      ]
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
