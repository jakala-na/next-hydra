# Admin identity credentials. Configure one provider block with credentials from
# an application/project that is isolated from the customer application.

# WorkOS
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD="replace_with_a_distinct_32_character_secret"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://admin.next-hydra.localhost/api/auth/callback"
# Leave WORKOS_COOKIE_DOMAIN unset so the admin session remains host-only.
WORKOS_COOKIE_NAME="next-hydra-admin-session"

# Clerk
CLERK_AUTHORIZED_PARTIES="https://admin.next-hydra.localhost"
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

NEXT_PUBLIC_API_URL="https://api.next-hydra.localhost"
