{
  "name": "web",
  "private": true,
  "portless": {
    "name": "web.next-hydra",
    "script": "dev:app"
  },
  "scripts": {
    "build": "NODE_USE_SYSTEM_CA=1 next build --turbopack",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless",
    "dev:app": "NODE_USE_SYSTEM_CA=1 next dev --turbopack",
    "start": "NODE_USE_SYSTEM_CA=1 next start",
    "typecheck": "next typegen && pnpm --workspace-root exec tsc --noEmit --project apps/web/tsconfig.json"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@rescale/nemo": "^2.1.1",
    "@t3-oss/env-nextjs": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "^4.1.7",
    "typescript": "catalog:typescript7"
  }
}
