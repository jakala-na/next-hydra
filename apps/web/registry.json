          "type": "registry:file"
        },
        {
          "path": "i18n/request.ts",
          "target": "~/apps/web/i18n/request.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/cms-revalidation.ts",
          "target": "~/apps/web/lib/cms-revalidation.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/cms-routing.ts",
          "target": "~/apps/web/lib/cms-routing.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/production-url.ts",
          "target": "~/apps/web/lib/production-url.ts",
          "type": "registry:file"
        },
        {
          "path": "postcss.config.mjs",
          "target": "~/apps/web/postcss.config.mjs",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/global-error.tsx",
          "target": "~/apps/web/app/[locale]/global-error.tsx",
          "type": "registry:file"
        },
        {
          "path": "instrumentation-client.ts",
          "target": "~/apps/web/instrumentation-client.ts",
          "type": "registry:file"
        },
        {
          "path": "instrumentation.ts",
          "target": "~/apps/web/instrumentation.ts",
          "type": "registry:file"
        },
        {
          "path": "vitest.config.ts",
          "target": "~/apps/web/vitest.config.ts",
          "type": "registry:file"
        },
        {
          "path": "vercel.json",
          "target": "~/apps/web/vercel.json",
          "type": "registry:file"
        },
        {
          "path": "scripts/skip-ci.js",
          "target": "~/apps/web/scripts/skip-ci.js",
          "type": "registry:file"
        },
        {
          "path": "env-schema.ts",
          "target": "~/apps/web/env-schema.ts",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/package.json",
