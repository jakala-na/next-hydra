{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "app-web-base",
      "type": "registry:item",
      "title": "Shared web application source",
      "description": "Installs the application files shared by every web profile.",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/app/web/base",
          "kind": "app-profile",
          "app": "web"
        }
      },
      "files": [
        {
          "path": ".env.example",
          "target": "~/apps/web/.env.example",
          "type": "registry:file"
        },
        {
          "path": ".gitignore",
          "target": "~/apps/web/.gitignore",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/[[...url]]/page.tsx",
          "target": "~/apps/web/app/[locale]/[[...url]]/page.tsx",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/robots.ts",
          "target": "~/apps/web/app/[locale]/robots.ts",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/sitemap.ts",
          "target": "~/apps/web/app/[locale]/sitemap.ts",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/styles.css",
          "target": "~/apps/web/app/[locale]/styles.css",
          "type": "registry:file"
        },
        {
          "path": "app/api/revalidate/route.ts",
          "target": "~/apps/web/app/api/revalidate/route.ts",
          "type": "registry:file"
        },
        {
          "path": "global.d.ts",
          "target": "~/apps/web/global.d.ts",
          "type": "registry:file"
        },
        {
          "path": "i18n/request.ts",
          "target": "~/apps/web/i18n/request.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/cms-revalidation.ts",
          "target": "~/apps/web/lib/cms-revalidation.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/cms-routing.ts",
          "target": "~/apps/web/lib/cms-routing.ts",
          "type": "registry:file"
        },
        {
          "path": "lib/production-url.ts",
          "target": "~/apps/web/lib/production-url.ts",
          "type": "registry:file"
        },
        {
          "path": "postcss.config.mjs",
          "target": "~/apps/web/postcss.config.mjs",
          "type": "registry:file"
        }
      ]
    },
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "app-web-content",
      "type": "registry:item",
      "title": "Content web application profile",
      "description": "Installs a CMS-only web application without Auth, Commerce, Search, or cart controls.",
      "registryDependencies": ["app-web-base", "auth-contract"],
      "meta": {
        "nextHydra": {
          "id": "next-hydra/app/web/content",
          "kind": "app-profile",
          "app": "web",
          "providerSlots": {
            "auth": "forbidden",
            "cms": "required",
            "commerce": "forbidden"
          },
          "providerDependencies": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "slot": "cms"
            }
          ]
        }
      },
      "files": [
        {
          "path": "registry/apps/web/app/[locale]/layout.tsx",
          "target": "~/apps/web/app/[locale]/layout.tsx",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/components/layout/document-shell.tsx",
          "target": "~/apps/web/components/layout/document-shell.tsx",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/env.ts",
          "target": "~/apps/web/env.ts",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/next.config.ts",
          "target": "~/apps/web/next.config.ts",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/package.json",
          "target": "~/apps/web/package.json",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/proxy.ts",
          "target": "~/apps/web/proxy.ts",
          "type": "registry:file"
        },
        {
          "path": "registry/apps/web/tsconfig.json",
          "target": "~/apps/web/tsconfig.json",
          "type": "registry:file"
        }
      ]
    },
