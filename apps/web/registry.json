{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "app-web",
      "type": "registry:item",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/app/web",
          "kind": "package",
          "providerSlots": {
            "cms": "required",
            "auth": "optional",
            "commerce": "optional"
          },
          "providerDependencies": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "slot": "cms"
            }
          ]
        },
        "composition": {
          "templates": [
            {
              "source": "apps/web/registry/templates/layout.tsx.template",
              "target": "apps/web/app/[locale]/layout.tsx",
              "slots": {
                "account": "element",
                "commerce": "wrapper",
                "cart": "element",
                "businessUnit": "element",
                "search": "element"
              }
            },
            {
              "source": "apps/web/registry/templates/document-shell.tsx.template",
              "target": "apps/web/components/layout/document-shell.tsx",
              "slots": {
                "providers": "wrapper",
                "toolbar": "element"
              }
            },
            {
              "source": "apps/web/registry/templates/proxy.ts.template",
              "target": "apps/web/proxy.ts",
              "slots": {
                "proxy": "call"
              }
            },
            {
              "source": "apps/web/registry/templates/env.ts.template",
              "target": "apps/web/env.ts",
              "slots": {
                "environment": "factory"
              }
            },
            {
              "source": "apps/web/registry/templates/next.config.ts.template",
              "target": "apps/web/next.config.ts",
              "slots": {
                "configuration": "call"
              }
            }
          ]
        }
      },
      "title": "Web application",
      "description": "One shared web application. Installed packages supply recipes for routes, runtime wiring and layout slot bindings.",
      "files": [
        {
          "path": ".gitignore",
          "target": "~/apps/web/.gitignore",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/[[...url]]/page.tsx",
          "target": "~/apps/web/app/[locale]/[[...url]]/page.tsx",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/robots.ts",
          "target": "~/apps/web/app/[locale]/robots.ts",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/sitemap.ts",
          "target": "~/apps/web/app/[locale]/sitemap.ts",
          "type": "registry:file"
        },
        {
          "path": "app/[locale]/styles.css",
          "target": "~/apps/web/app/[locale]/styles.css",
          "type": "registry:file"
        },
        {
          "path": "app/api/revalidate/route.ts",
          "target": "~/apps/web/app/api/revalidate/route.ts",
          "type": "registry:file"
        },
        {
          "path": "global.d.ts",
          "target": "~/apps/web/global.d.ts",
          "type": "registry:file"
        },
        {
          "path": "i18n/request-locale.ts",
