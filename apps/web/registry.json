          "type": "registry:file"
        },
        {
          "path": "registry/templates/web.env.example",
          "target": "~/apps/web/.env.example",
          "type": "registry:file"
        }
      ],
      "registryDependencies": ["workspace-cli", "workspace-e2e"]
    },
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "auth-web",
      "type": "registry:item",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/recipe/auth-web",
          "kind": "recipe",
          "providerDependencies": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "slot": "auth"
            },
            {
              "cwd": "packages/feature-flags",
              "section": "dependencies",
              "slot": "auth"
            },
            {
              "cwd": "apps/cli",
              "slot": "auth",
              "section": "dependencies"
            }
          ],
          "packages": [
            {
              "cwd": "apps/web",
              "name": "@repo/feature-flags",
              "specifier": "workspace:*",
              "section": "dependencies"
            },
            {
              "cwd": "apps/web",
              "name": "lucide-react",
              "specifier": "^0.511.0",
              "section": "dependencies"
            }
          ]
        },
        "composition": {
          "templates": [
            {
              "source": "apps/web/registry/templates/account-links.ts.template",
              "target": "apps/web/components/layout/account-links.ts",
              "slots": {
                "links": "members"
              }
            }
          ],
          "slotBindings": [
            {
              "target": "apps/web/components/layout/document-shell.tsx",
              "slot": "providers",
              "module": "@repo/auth/provider",
              "export": "AuthProvider",
              "order": 10
            },
            {
              "target": "apps/web/app/[locale]/layout.tsx",
              "slot": "account",
              "module": "@/components/layout/account-menu",
              "export": "AccountMenu",
              "order": 10
            },
            {
              "target": "apps/web/proxy.ts",
              "slot": "proxy",
              "module": "@repo/auth/proxy",
              "export": "authProxy",
              "order": 10
            },
            {
              "target": "apps/web/env.ts",
              "slot": "environment",
              "module": "@repo/auth/keys",
              "export": "keys",
              "order": 10
            },
            {
              "target": "apps/web/components/layout/document-shell.tsx",
              "slot": "toolbar",
              "module": "@repo/feature-flags/components/toolbar",
              "export": "Toolbar",
              "order": 0
            },
            {
              "target": "apps/web/next.config.ts",
              "slot": "configuration",
              "module": "@repo/feature-flags/lib/toolbar",
              "export": "withToolbar",
              "order": 30
            },
            {
              "target": "apps/web/env.ts",
              "slot": "environment",
              "module": "@repo/feature-flags/keys",
              "export": "keys",
              "as": "flags",
              "order": 40
            },
            {
              "target": "apps/cli/src/program.ts",
              "slot": "commands",
              "module": "@repo/auth/cli",
              "export": "createAuthCommand",
              "order": 10
            }
          ]
        }
      },
      "title": "Auth web recipe",
      "files": [
        {
          "path": "components/layout/account-menu-client.tsx",
          "target": "~/apps/web/components/layout/account-menu-client.tsx",
          "type": "registry:file"
        },
        {
          "path": "components/layout/account-menu.tsx",
          "target": "~/apps/web/components/layout/account-menu.tsx",
          "type": "registry:file"
        },
        {
          "path": "app/.well-known/vercel/flags/route.ts",
          "target": "~/apps/web/app/.well-known/vercel/flags/route.ts",
          "type": "registry:file"
        }
      ],
      "registryDependencies": ["auth-e2e"]
    },
    {
      "name": "app-web-navigation-search",
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "type": "registry:item",
      "title": "Navigation search",
      "description": "Search the CMS navigation in desktop and mobile headers without requiring Commerce.",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/add-on/navigation-search",
          "kind": "add-on",
          "packages": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "name": "lucide-react",
              "specifier": "^0.511.0"
            }
          ]
        },
        "composition": {
          "slotBindings": [
            {
              "target": "apps/web/app/[locale]/layout.tsx",
              "slot": "search",
              "module": "@/components/layout/header-search",
              "export": "HeaderSearch"
            }
          ]
        }
      },
      "files": [
        {
          "path": "components/layout/header-search.tsx",
          "target": "~/apps/web/components/layout/header-search.tsx",
          "type": "registry:file"
        },
        {
          "path": "components/layout/navigation-search.tsx",
          "target": "~/apps/web/components/layout/navigation-search.tsx",
          "type": "registry:file"
        }
      ]
    },
