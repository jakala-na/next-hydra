{
  "extends": [
    "@repo/typescript-config/effect-nextjs.json",
    "@repo/cms/typescript-config.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@repo/auth": [
        "../../packages/auth-clerk"
      ],
      "@repo/auth/*": [
        "../../packages/auth-clerk/*"
      ],
      "@repo/cms": [
        "../../packages/cms-contentstack"
      ],
      "@repo/cms/*": [
        "../../packages/cms-contentstack/*"
      ],
      "@repo/commerce/runtime": ["./lib/commerce-runtime.ts"],
      "@repo/commerce-provider": [
        "../../packages/commerce-commercetools"
      ],
      "@repo/commerce-provider/*": [
        "../../packages/commerce-commercetools/*"
      ],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
