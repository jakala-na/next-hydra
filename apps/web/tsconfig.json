{
  "extends": [
    "@repo/typescript-config/effect-nextjs.json",
    "@repo/cms/typescript-config.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@repo/auth": ["../../packages/auth-workos"],
      "@repo/auth/*": ["../../packages/auth-workos/*"],
      "@repo/cms": ["../../packages/cms-drupal"],
      "@repo/cms/*": ["../../packages/cms-drupal/*"],
      "@repo/commerce/runtime": ["./lib/commerce-runtime.ts"],
      "@repo/commerce-provider": ["../../packages/commerce-commercetools"],
      "@repo/commerce-provider/*": ["../../packages/commerce-commercetools/*"],
      "@repo/search-provider": ["../../packages/search-algolia"],
      "@repo/search-provider/*": ["../../packages/search-algolia/*"],
      "@repo/search/runtime": ["./lib/search-runtime.ts"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.template.ts", "**/*.template.tsx"]
}
