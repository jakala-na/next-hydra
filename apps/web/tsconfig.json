{
  "extends": [
    "@repo/typescript-config/effect-nextjs.json",
    "@repo/cms/typescript-config.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@repo/auth": ["./node_modules/@repo/auth"],
      "@repo/auth/*": ["./node_modules/@repo/auth/*"],
      "@repo/cms": ["./node_modules/@repo/cms"],
      "@repo/cms/*": ["./node_modules/@repo/cms/*"],
      "@repo/commerce/runtime": ["./lib/commerce-runtime.ts"],
      "@repo/commerce-provider": ["./node_modules/@repo/commerce-provider"],
      "@repo/commerce-provider/*": ["./node_modules/@repo/commerce-provider/*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
