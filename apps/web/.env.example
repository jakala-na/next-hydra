# Server
RESEND_FROM=""
RESEND_TOKEN=""
FLAGS_SECRET=""
ARCJET_KEY=""
# Additional embedding origins for any CMS, preserving self and provider defaults.
# Comma-separated exact HTTP(S) origins; no paths or wildcards. Restart/redeploy after changes.
FRAME_ANCESTORS=""
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD=""
VERCEL_PROJECT_PRODUCTION_URL="web.next-hydra.localhost"

# Clerk alternative for the customer identity application
CLERK_AUTHORIZED_PARTIES="https://web.next-hydra.localhost"
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

### CMS

# Resolves the application root to this CMS page path.
CMS_HOMEPAGE_SLUG=homepage
# Must match the revalidation secret configured for the CMS frontend site.
CMS_REVALIDATION_SECRET=replace_with_at_least_32_random_characters

### Commercetools

# Server-side variables
COMMERCETOOLS_PROJECT_KEY=your_project_key_here
COMMERCETOOLS_CLIENT_ID=your_client_id_here
COMMERCETOOLS_CLIENT_SECRET=your_client_secret_here
# Must include manage_payments:<project-key> (or manage_project:<project-key>).
COMMERCETOOLS_SCOPE=your_scope_here
COMMERCETOOLS_REGION=your_region_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

### Algolia

# Server-side credentials
ALGOLIA_APPLICATION_ID=""
ALGOLIA_SEARCH_API_KEY=""
# Comma-separated commercetools Customer Group IDs allowed for price slicing.
ALGOLIA_PRICE_CUSTOMER_GROUP_IDS=""

# Optional namespace for provisioned Product, Content, and Query Suggestions indices.
# ALGOLIA_INDEX_PREFIX="development"

# Client
NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://web.next-hydra.localhost/api/auth/callback"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_WEB_URL="https://web.next-hydra.localhost"
NEXT_PUBLIC_API_URL="https://api.next-hydra.localhost"
