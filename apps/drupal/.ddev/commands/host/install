#!/bin/bash

# Description: Installs the Next Hydra Drupal starter.

set -euo pipefail

## Start DDEV
ddev start

## Install Dependencies
ddev composer install

## Install Drupal
ddev drush site:install minimal --verbose -y

## Apply the starter recipe
starter_recipe=../recipes/next-hydra-starter
if [[ -f recipes/product-collection/recipe.yml ]]; then
  starter_recipe=../recipes/product-collection
fi
ddev drush recipe "$starter_recipe" -v
ddev drush cr

### Generate scopes
ddev drush php:script scripts/scopes

### Generate consumers
ddev drush php:script scripts/consumers

### Configure frontend cache revalidation
ddev drush php:script scripts/revalidation

### Rebuild permissions
ddev drush php-eval 'node_access_rebuild();'

ddev drush cr

ddev drush uli
