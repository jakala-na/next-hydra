#!/bin/bash

# Description: Installs Drupal with the selected base or Commerce recipe.

set -euo pipefail

## Start DDEV
ddev start

## Install Dependencies
ddev composer install

## Install Drupal
ddev drush site:install minimal --verbose -y

## Apply the selected recipe (Commerce includes the base recipe)
site_recipe=../recipes/next-hydra-base
if [[ -f recipes/next-hydra-commerce/recipe.yml ]]; then
  site_recipe=../recipes/next-hydra-commerce
fi
ddev drush recipe "$site_recipe" -v
ddev drush cr

### Generate scopes
ddev drush php:script scripts/scopes

### Generate consumers
ddev drush php:script scripts/consumers

### Configure frontend cache revalidation
ddev drush php:script scripts/revalidation

### Rebuild permissions
ddev drush php-eval 'node_access_rebuild();'

ddev drush cr

ddev drush uli
