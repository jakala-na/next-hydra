{
  "name": "next-hydra/drupal",
  "description": "Drupal backend for the Next Hydra composable commerce starter",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/drupal",
  "support": {
    "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
    "chat": "https://www.drupal.org/node/314178"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "acquia/drupal-recommended-settings": "^1.2",
    "composer/installers": "^2.3",
    "cweagans/composer-patches": "~2.0",
    "drupal/canvas": "dev-1.x#9211e2e8109501ceeb2d7f1a3a8ef3c913432a67",
    "drupal/canvas_translate": "^1.0@alpha",
    "drupal/core-composer-scaffold": "^11.4",
    "drupal/core-project-message": "^11.4",
    "drupal/core-recipe-unpack": "^11.4",
    "drupal/core-recommended": "^11.4",
    "drupal/custom_elements": "^3.4",
    "drupal/gin": "^5.0",
    "drupal/gin_toolbar": "^3.0",
    "drupal/graphql_compose": "^2.4",
    "drupal/graphql_compose_preview": "^1.1",
    "drupal/mysql57": "^1.0",
    "drupal/next": "^2.1",
    "drupal/paragraphs": "^1.19",
    "drupal/simple_oauth": "^6.1",
    "drupal/view_unpublished": "^1.3",
    "drush/drush": "^13.7"
  },
  "require-dev": {
    "drupal/core-dev": "^11.4"
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "acquia/drupal-recommended-settings": true,
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "drupal/core-recipe-unpack": true,
      "php-http/discovery": true,
      "php-tuf/composer-integration": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    },
    "sort-packages": true
  },
  "extra": {
    "patches": {
      "drupal/canvas": [
        {
          "description": "Expose complete Headless cacheability metadata",
          "url": "patches/drupal-canvas-cacheability.patch"
        },
        {
          "description": "Resolve Canvas entity references in translated default content",
          "url": "patches/drupal-canvas-default-content-translations.patch"
        }
      ],
      "drupal/canvas_translate": [
        {
          "description": "Support page variant translations (upstream MR !9 at 38b37e37)",
          "url": "patches/drupal-canvas-translate-page-variants.patch",
          "extra": {
            "issue": "https://www.drupal.org/project/canvas_translate/issues/3620535",
            "merge-request": "https://git.drupalcode.org/project/canvas_translate/-/merge_requests/9",
            "base-commit": "50e7b63f66c7be345d07ba47339e5603c76984f8",
            "patched-commit": "38b37e378a589c8318e7e78d099f03fd5b9bd103"
          }
        }
      ],
      "drupal/next": [
        {
          "description": "Allow cache-tag revalidation for config entities",
          "url": "patches/drupal-next-2.1-config-entity-cache-tags.patch"
        }
      ],
      "drupal/subrequests": [
        {
          "description": "Declare the optional validator explicitly nullable for PHP 8.4",
          "url": "patches/drupal-subrequests-3.0.12-php-8.4-nullable-validator.patch"
        }
      ]
    },
    "drupal-scaffold": {
      "locations": {
        "web-root": "docroot/"
      }
    },
    "installer-paths": {
      "docroot/core": [
        "type:drupal-core"
      ],
      "docroot/libraries/{$name}": [
        "type:drupal-library"
      ],
      "docroot/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "docroot/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "docroot/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "docroot/modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "docroot/profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "docroot/themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ],
      "recipes/{$name}": [
        "type:drupal-recipe"
      ]
    },
    "drupal-core-project-message": {
      "include-keys": [
        "homepage",
        "support"
      ],
      "post-create-project-cmd-message": [
        "<bg=blue;fg=white>                                                         </>",
        "<bg=blue;fg=white>  Congratulations, you\u2019ve installed the Drupal codebase  </>",
        "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
        "<bg=blue;fg=white>                                                         </>",
        "",
        "<bg=yellow;fg=black>Next steps</>:",
        "  * Install the site: https://www.drupal.org/docs/installing-drupal",
        "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
        "  * Get support: https://www.drupal.org/support",
        "  * Get involved with the Drupal community:",
        "      https://www.drupal.org/getting-involved",
        "  * Remove the plugin that prints this message:",
        "      composer remove drupal/core-project-message"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "bash scripts/build-canvas.sh"
    ],
    "post-update-cmd": [
      "bash scripts/build-canvas.sh"
    ]
  }
}
