diff --git a/modules/canvas_headless/src/RenderConverter/CustomElementRootNormalizer.php b/modules/canvas_headless/src/RenderConverter/CustomElementRootNormalizer.php
new file mode 100644
--- /dev/null
+++ b/modules/canvas_headless/src/RenderConverter/CustomElementRootNormalizer.php
@@ -0,0 +1,35 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas_headless\RenderConverter;
+
+/**
+ * Normalizes Custom Elements JSON into a single Canvas render tree root.
+ *
+ * @internal
+ */
+final class CustomElementRootNormalizer {
+
+  /**
+   * Converts Custom Elements' root-list representation to one tree root.
+   */
+  public static function normalize(mixed $content): mixed {
+    // @todo Remove additional Custom Elements JSON normalization when json-render support is added.
+    if (\is_array($content) && $content === ['element' => 'drupal-markup']) {
+      return NULL;
+    }
+    if (!\is_array($content) || !array_is_list($content)) {
+      return $content;
+    }
+    return match (\count($content)) {
+      0 => NULL,
+      1 => $content[0],
+      default => [
+        'element' => 'renderless-container',
+        'slots' => ['default' => $content],
+      ],
+    };
+  }
+
+}
