+<?php
+
+namespace Drupal\Tests\next\Kernel\Plugin;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\next\Entity\NextEntityTypeConfig;
+use Drupal\next\Entity\NextSite;
+use Drupal\user\Entity\Role;
+use GuzzleHttp\ClientInterface;
+use GuzzleHttp\Psr7\Response as GuzzleResponse;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+use Prophecy\PhpUnit\ProphecyTrait;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Tests the cache tag revalidator plugin.
+ *
+ * @coversDefaultClass \Drupal\next\Plugin\Next\Revalidator\CacheTag
+ *
+ * @group next
+ */
+#[RunTestsInSeparateProcesses]
+class CacheTagRevalidatorTest extends KernelTestBase {
+
+  use ProphecyTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'next',
+    'path',
+    'path_alias',
+    'system',
+    'user',
+  ];
+
+  /**
+   * Tests that config entity cache tags are revalidated after a save.
+   *
+   * @covers ::revalidate
+   */
+  public function testConfigEntityRevalidate(): void {
+    $client = $this->prophesize(ClientInterface::class);
+    $this->container->set('http_client', $client->reveal());
+
+    NextSite::create([
+      'id' => 'frontend',
+      'revalidate_url' => 'https://frontend.example/api/revalidate',
+    ])->save();
+    NextEntityTypeConfig::create([
+      'id' => 'user_role.user_role',
+      'site_resolver' => 'site_selector',
+      'configuration' => [
+        'sites' => ['frontend' => 'frontend'],
+      ],
+      'revalidator' => 'cache_tag',
+      'revalidator_configuration' => [
+        'entity_tag' => TRUE,
+        'entity_list_tag' => FALSE,
+      ],
+    ])->save();
+
+    $client->request(
+      'GET',
+      'https://frontend.example/api/revalidate?tags=config%3Auser.role.editor',
+    )->shouldBeCalledOnce()->willReturn(new GuzzleResponse());
+
+    Role::create([
+      'id' => 'editor',
+      'label' => 'Editor',
+    ])->save();
+    $this->container->get('kernel')->terminate(
+      Request::create('/'),
+      new Response(),
+    );
+  }
+
+}
