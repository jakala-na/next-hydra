+++ b/src/Hook/PageVariantUpgradeHooks.php
@@ -0,0 +1,39 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas_translate\Hook;
+
+use Drupal\canvas\Entity\PageVariant;
+use Drupal\canvas_translate\Service\PageRegionTranslationUpgrade;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+
+/**
+ * Moves page region translations when Canvas turns regions into a variant.
+ */
+final class PageVariantUpgradeHooks {
+
+  public function __construct(
+    private readonly PageRegionTranslationUpgrade $upgrade,
+  ) {}
+
+  /**
+   * Implements hook_ENTITY_TYPE_insert() for page_variant.
+   *
+   * Canvas creates a "theme_<theme>" variant when it converts a theme's page
+   * regions: in its own update hook, or later when Canvas is enabled for a
+   * theme on the theme settings form. Move the regions' drafts, approvals and
+   * published translations over right away, so nothing is left behind on the
+   * regions.
+   *
+   * @see \Drupal\canvas\PageVariantMigration::createFromPageRegions()
+   */
+  #[Hook('page_variant_insert')]
+  public function pageVariantInsert(EntityInterface $entity): void {
+    if ($entity instanceof PageVariant && PageRegionTranslationUpgrade::isThemeVariant($entity)) {
+      $this->upgrade->upgrade($entity);
+    }
+  }
+
+}
diff --git a/src/Service/PageRegionTranslationUpgrade.php b/src/Service/PageRegionTranslationUpgrade.php
new file mode 100644
index 0000000..0dfdb21
--- /dev/null
+++ b/src/Service/PageRegionTranslationUpgrade.php
@@ -0,0 +1,254 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas_translate\Service;
+
+use Drupal\canvas\Entity\ComponentTreeConfigEntityBase;
+use Drupal\canvas\Entity\PageVariant;
+use Drupal\canvas\Plugin\Field\FieldType\ComponentTreeItem;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Language\LanguageManagerInterface;
+use Drupal\language\Config\LanguageConfigFactoryOverrideInterface;
+
+/**
+ * Moves page region translation state to the page variant that replaced them.
+ *
+ * Canvas 1.11 turns a theme's page regions into one page variant, named
+ * "theme_<theme>". Canvas copies the published translations (the language
+ * config overrides) but knows nothing about this module's drafts and
+ * approvals. It also copies nothing that was published after its own update
+ * ran, which happens when Canvas is updated before Canvas Translate.
+ *
+ * The regions a variant was built from are found by the component UUIDs the
+ * two still share. Then, for each language:
+ * - region drafts move into the variant draft,
+ * - the approval moves along when every region that had a draft was approved,
+ * - published region translations the variant override lacks are added.
+ *
+ * Example: the "header" region had a Hungarian draft for its heading. After
+ * the upgrade the same heading, same UUID, sits in variant "theme_olivero",
+ * and the Hungarian draft shows up there.
+ *
+ * Only entries whose UUID is in the variant move. Regions Canvas did not
+ * migrate (other themes, disabled regions) keep their drafts and overrides.
+ * The staleness baseline is not copied; it is written again on the next
+ * publish of the variant.
+ */
+final class PageRegionTranslationUpgrade {
+
+  /**
+   * Canvas names the variant it builds from a theme's regions like this.
+   */
+  public const string VARIANT_ID_PREFIX = 'theme_';
+
+  // Entity type IDs as strings, so this class loads on a Canvas that has only
+  // one of the two entity types.
+  private const string PAGE_VARIANT = 'page_variant';
+  private const string PAGE_REGION = 'page_region';
+
+  public function __construct(
+    private readonly TranslationDraftStore $draftStore,
+    private readonly ApprovalStore $approvalStore,
+    private readonly EntityTypeManagerInterface $entityTypeManager,
+    private readonly LanguageManagerInterface $languageManager,
+    private readonly LanguageConfigFactoryOverrideInterface $languageConfigOverride,
+  ) {}
+
+  /**
+   * Whether Canvas built this variant from a theme's page regions.
+   */
+  public static function isThemeVariant(PageVariant $variant): bool {
+    return \str_starts_with((string) $variant->id(), self::VARIANT_ID_PREFIX);
+  }
+
+  /**
+   * Upgrades every theme variant on the site.
+   *
+   * @return array<string, array{drafts: int, approvals: int, overrides: int}>
+   *   What moved, keyed by variant ID.
+   */
+  public function upgradeAll(): array {
+    if (!$this->entityTypeManager->hasDefinition(self::PAGE_VARIANT)) {
+      return [];
+    }
+    $result = [];
+    foreach ($this->entityTypeManager->getStorage(self::PAGE_VARIANT)->loadMultiple() as $variant) {
+      \assert($variant instanceof PageVariant);
+      if (self::isThemeVariant($variant)) {
+        $result[(string) $variant->id()] = $this->upgrade($variant);
+      }
+    }
+    return $result;
+  }
+
+  /**
+   * Moves the translation state of the regions a variant was built from.
+   *
+   * Safe to run more than once: a second run finds nothing left to move.
+   *
+   * @return array{drafts: int, approvals: int, overrides: int}
+   *   How many draft entries, approvals and override entries moved.
+   */
+  public function upgrade(PageVariant $variant): array {
+    $counts = ['drafts' => 0, 'approvals' => 0, 'overrides' => 0];
+    // Canvas 2.0 removes page regions. Nothing left to move then.
+    if (!$this->entityTypeManager->hasDefinition(self::PAGE_REGION)) {
+      return $counts;
+    }
+    $uuids = self::uuids($variant);
+    $regions = [];
+    foreach ($this->entityTypeManager->getStorage(self::PAGE_REGION)->loadMultiple() as $region) {
+      \assert($region instanceof ComponentTreeConfigEntityBase);
+      if (\array_intersect_key(self::uuids($region), $uuids) !== []) {
+        $regions[] = $region;
+      }
+    }
+    if ($regions === []) {
+      return $counts;
+    }
+    $variant_name = $variant->getConfigDependencyName();
+    foreach (\array_keys($this->languageManager->getLanguages()) as $langcode) {
+      $counts['drafts'] += $this->moveDrafts($regions, $uuids, $variant_name, $langcode, $counts['approvals']);
+      $counts['overrides'] += $this->mergeOverrides($regions, $uuids, $variant_name, $langcode);
+    }
+    return $counts;
+  }
+
+  /**
+   * Moves region draft entries for the variant's components into its draft.
+   *
+   * @param list<\Drupal\canvas\Entity\ComponentTreeConfigEntityBase> $regions
+   *   The regions the variant was built from.
+   * @param array<string, true> $uuids
+   *   The variant's component UUIDs.
+   * @param string $variant_name
+   *   The variant's config name.
+   * @param string $langcode
+   *   The language.
+   * @param int $approvals
+   *   Incremented when the approval moves too.
+   *
+   * @return int
+   *   How many draft entries moved.
+   */
+  private function moveDrafts(array $regions, array $uuids, string $variant_name, string $langcode, int &$approvals): int {
+    $variant_key = TranslationDraftStore::key($variant_name, $langcode);
+    $had_own_draft = $this->draftStore->has($variant_key);
+    $moved = [];
+    $all_approved = TRUE;
+    foreach ($regions as $region) {
+      $region_key = TranslationDraftStore::key($region->getConfigDependencyName(), $langcode);
+      $draft = $this->draftStore->get($region_key);
+      if ($draft === NULL) {
+        continue;
+      }
+      $keep = [];
+      foreach ($draft as $key => $text) {
+        if (isset($uuids[self::uuidOfKey((string) $key)])) {
+          $moved[$key] = $text;
+        }
+        else {
+          $keep[$key] = $text;
+        }
+      }
+      if ($keep === $draft) {
+        // Nothing of this region's draft is in the variant.
+        continue;
+      }
+      $all_approved = $all_approved && $this->approvalStore->isApproved($region_key);
+      if ($keep === []) {
+        $this->draftStore->delete($region_key);
+        $this->approvalStore->clear($region_key);
+      }
+      else {
+        $this->draftStore->set($region_key, $keep);
+      }
+    }
+    if ($moved === []) {
+      return 0;
+    }
+    // A draft the variant already had wins over the moved entries.
+    $this->draftStore->set($variant_key, ($this->draftStore->get($variant_key) ?? []) + $moved);
+    // An approval covers a whole draft. Keep it only when every moved entry
+    // was approved and the variant had no draft of its own waiting for review.
+    if (!$had_own_draft && $all_approved) {
+      $this->approvalStore->approve($variant_key);
+      $approvals++;
+    }
+    return \count($moved);
+  }
+
+  /**
+   * Adds published region translations the variant override does not have.
+   *
+   * Canvas copied these once, when it converted the regions. Anything
+   * published to a region after that only exists on the region.
+   *
+   * @param list<\Drupal\canvas\Entity\ComponentTreeConfigEntityBase> $regions
+   *   The regions the variant was built from.
+   * @param array<string, true> $uuids
+   *   The variant's component UUIDs.
+   * @param string $variant_name
+   *   The variant's config name.
+   * @param string $langcode
+   *   The language.
+   *
+   * @return int
+   *   How many component entries were added to the variant override.
+   */
+  private function mergeOverrides(array $regions, array $uuids, string $variant_name, string $langcode): int {
+    $from_regions = [];
+    foreach ($regions as $region) {
+      $override = $this->languageConfigOverride->getOverride($langcode, $region->getConfigDependencyName());
+      if ($override->isNew()) {
+        continue;
+      }
+      $tree = $override->get('component_tree');
+      if (\is_array($tree)) {
+        $from_regions += \array_intersect_key($tree, $uuids);
+      }
+    }
+    if ($from_regions === []) {
+      return 0;
+    }
+    $override = $this->languageConfigOverride->getOverride($langcode, $variant_name);
+    $data = $override->isNew() ? [] : $override->getRawData();
+    $data = \is_array($data) ? $data : [];
+    $existing = \is_array($data['component_tree'] ?? NULL) ? $data['component_tree'] : [];
+    // The variant's own translations win. Only fill in what it lacks.
+    $new = \array_diff_key($from_regions, $existing);
+    if ($new === []) {
+      return 0;
+    }
+    $data['component_tree'] = $existing + $new;
+    $override->setData($data)->save();
+    return \count($new);
+  }
+
+  /**
+   * The component UUIDs in a config entity's tree, as array keys.
+   *
+   * @return array<string, true>
+   *   Keyed by UUID.
+   */
+  private static function uuids(ComponentTreeConfigEntityBase $entity): array {
+    $uuids = [];
+    foreach ($entity->getComponentTree() as $item) {
+      \assert($item instanceof ComponentTreeItem);
+      $uuids[$item->getUuid()] = TRUE;
+    }
+    return $uuids;
+  }
+
+  /**
+   * The UUID in a draft key like "component_tree.<uuid>.inputs.text".
+   */
+  private static function uuidOfKey(string $key): string {
+    if (!\str_starts_with($key, 'component_tree.')) {
+      return '';
+    }
+    return \explode('.', $key)[1] ?? '';
+  }
+
+}
diff --git a/tests/src/Kernel/PageRegionTranslationUpgradeTest.php b/tests/src/Kernel/PageRegionTranslationUpgradeTest.php
new file mode 100644
index 0000000..71e18e6
--- /dev/null
+++ b/tests/src/Kernel/PageRegionTranslationUpgradeTest.php
@@ -0,0 +1,340 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\canvas_translate\Kernel;
+
+use Drupal\canvas\Entity\Component;
+use Drupal\canvas\Entity\ComponentTreeConfigEntityBase;
+use Drupal\canvas\Entity\Page;
+use Drupal\canvas\Entity\PageVariant;
+use Drupal\canvas\Plugin\Canvas\ComponentSource\Marker;
+use Drupal\canvas_translate\Service\ApprovalStore;
+use Drupal\canvas_translate\Service\PageRegionTranslationUpgrade;
+use Drupal\canvas_translate\Service\TranslationDraftStore;
+use Drupal\language\ConfigurableLanguageManagerInterface;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\Tests\canvas\Kernel\CanvasKernelTestBase;
+use Drupal\Tests\canvas\Traits\GenerateComponentConfigTrait;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests moving page region translations to the page variant Canvas built.
+ *
+ * Canvas keeps the component UUIDs when it converts a theme's regions into a
+ * "theme_<theme>" variant. Drafts, approvals and published translations are
+ * all keyed by those UUIDs, so they can follow the components.
+ */
+#[RunTestsInSeparateProcesses]
+#[CoversClass(PageRegionTranslationUpgrade::class)]
+#[Group('canvas')]
+#[Group('canvas_translation')]
+final class PageRegionTranslationUpgradeTest extends CanvasKernelTestBase {
+
+  use GenerateComponentConfigTrait;
+
+  private const string UUID_A = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+  private const string UUID_B = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
+  private const string UUID_C = 'cccccccc-cccc-4ccc-8ccc-cccccccccccc';
+  private const string MARKER_VERSION = '3b12c0b99a6caecc';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    ...CanvasKernelTestBase::CANVAS_KERNEL_TEST_MINIMAL_MODULES,
+    'canvas_test_sdc',
+    'language',
+    'content_translation',
+    'canvas_translate',
+  ];
+
+  /**
+   * The draft store.
+   */
+  private TranslationDraftStore $drafts;
+
+  /**
+   * The approval store.
+   */
+  private ApprovalStore $approvals;
+
+  /**
+   * The language manager.
+   */
+  private ConfigurableLanguageManagerInterface $languageManager;
+
+  /**
+   * The service under test.
+   */
+  private PageRegionTranslationUpgrade $upgrade;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('path_alias');
+    $this->installEntitySchema(Page::ENTITY_TYPE_ID);
+    $this->installConfig(['language']);
+    ConfigurableLanguage::createFromLangcode('fr')->save();
+    ConfigurableLanguage::createFromLangcode('de')->save();
+    $this->generateComponentConfig();
+    // The marker component ships in config/install, which kernel tests do not
+    // import. A variant is only valid with exactly one marker in its tree.
+    if (Component::load(Marker::PAGE_CONTENT_COMPONENT_ID) === NULL) {
+      Component::create([
+        'id' => Marker::PAGE_CONTENT_COMPONENT_ID,
+        'label' => 'Page content',
+        'provider' => 'canvas',
+        'source' => Marker::SOURCE_PLUGIN_ID,
+        'source_local_id' => Marker::PAGE_CONTENT_LOCAL_ID,
+        'active_version' => self::MARKER_VERSION,
+        'versioned_properties' => [
+          'active' => [
+            'settings' => [],
+            'fallback_metadata' => ['slot_definitions' => []],
+          ],
+        ],
+        'dependencies' => ['enforced' => ['module' => ['canvas']]],
+      ])->save();
+    }
+    $this->drafts = $this->container->get(TranslationDraftStore::class);
+    $this->approvals = $this->container->get(ApprovalStore::class);
+    $language_manager = $this->container->get('language_manager');
+    \assert($language_manager instanceof ConfigurableLanguageManagerInterface);
+    $this->languageManager = $language_manager;
+    $this->upgrade = $this->container->get(PageRegionTranslationUpgrade::class);
+  }
+
+  /**
+   * Drafts, approvals and published translations follow the components.
+   *
+   * This is the site that updated Canvas first: the variant already exists,
+   * and translators kept working on the regions with the old Canvas Translate
+   * until this module was updated too.
+   */
+  public function testUpgradeMovesRegionState(): void {
+    // Two regions Canvas would migrate (A, B), and one it would not (C is
+    // disabled, so the variant does not contain its component).
+    $a = $this->createRegion('sidebar_first', self::UUID_A, 'A');
+    $b = $this->createRegion('header', self::UUID_B, 'B');
+    $c = $this->createRegion('sidebar_second', self::UUID_C, 'C', enabled: FALSE);
+    // The variant Canvas built: same components, same UUIDs, plus the marker.
+    $variant = $this->createThemeVariant([self::UUID_A => 'A', self::UUID_B => 'B']);
+
+    // Work that happened on the regions after that.
+    $this->drafts->set($this->key($a, 'fr'), [
+      $this->textKey(self::UUID_A) => 'A fr draft',
+      $this->labelKey(self::UUID_A) => 'A label fr',
+    ]);
+    $this->approvals->approve($this->key($a, 'fr'));
+    $this->drafts->set($this->key($b, 'fr'), [$this->textKey(self::UUID_B) => 'B fr draft']);
+    $this->drafts->set($this->key($c, 'fr'), [$this->textKey(self::UUID_C) => 'C fr draft']);
+    $this->drafts->set($this->key($a, 'de'), [$this->textKey(self::UUID_A) => 'A de draft']);
+    $this->approvals->approve($this->key($a, 'de'));
+
+    // Published translations on the regions. B's was published after Canvas
+    // migrated, so the variant does not have it; A's is older than what the
+    // variant already has.
+    $this->publish($a, 'fr', self::UUID_A, 'A fr live (old)');
+    $this->publish($b, 'fr', self::UUID_B, 'B fr live');
+    $this->publish($c, 'fr', self::UUID_C, 'C fr live');
+    $this->publish($variant, 'fr', self::UUID_A, 'A fr variant (newer)');
+
+    $counts = $this->upgrade->upgrade($variant);
+    self::assertSame(['drafts' => 4, 'approvals' => 1, 'overrides' => 1], $counts);
+
+    // Drafts: A and B moved to the variant, C stayed on its region.
+    self::assertSame($this->sorted([
+      $this->textKey(self::UUID_A) => 'A fr draft',
+      $this->labelKey(self::UUID_A) => 'A label fr',
+      $this->textKey(self::UUID_B) => 'B fr draft',
+    ]), $this->sorted($this->drafts->get($this->key($variant, 'fr'))));
+    self::assertSame([$this->textKey(self::UUID_A) => 'A de draft'], $this->drafts->get($this->key($variant, 'de')));
+    self::assertNull($this->drafts->get($this->key($a, 'fr')));
+    self::assertNull($this->drafts->get($this->key($a, 'de')));
+    self::assertNull($this->drafts->get($this->key($b, 'fr')));
+    self::assertSame([$this->textKey(self::UUID_C) => 'C fr draft'], $this->drafts->get($this->key($c, 'fr')));
+
+    // Approvals: French mixes an approved (A) and an unapproved (B) draft, so
+    // the variant is not approved. German only had approved work.
+    self::assertFalse($this->approvals->isApproved($this->key($variant, 'fr')));
+    self::assertTrue($this->approvals->isApproved($this->key($variant, 'de')));
+    self::assertFalse($this->approvals->isApproved($this->key($a, 'fr')));
+    self::assertFalse($this->approvals->isApproved($this->key($a, 'de')));
+
+    // Published: B's text was added, A's newer variant text was kept, C and
+    // the region overrides themselves were not touched.
+    $tree = $this->overrideTree($variant, 'fr');
+    self::assertSame('A fr variant (newer)', $tree[self::UUID_A]['inputs']['text']);
+    self::assertSame('B fr live', $tree[self::UUID_B]['inputs']['text']);
+    self::assertArrayNotHasKey(self::UUID_C, $tree);
+    self::assertSame('A fr live (old)', $this->overrideTree($a, 'fr')[self::UUID_A]['inputs']['text']);
+    self::assertSame('C fr live', $this->overrideTree($c, 'fr')[self::UUID_C]['inputs']['text']);
+
+    // A second run has nothing left to move.
+    self::assertSame(['drafts' => 0, 'approvals' => 0, 'overrides' => 0], $this->upgrade->upgrade($variant));
+  }
+
+  /**
+   * Creating a theme variant moves the region state right away.
+   */
+  public function testInsertHook(): void {
+    $a = $this->createRegion('sidebar_first', self::UUID_A, 'A');
+    $this->drafts->set($this->key($a, 'fr'), [$this->textKey(self::UUID_A) => 'A fr draft']);
+
+    // A variant not built from regions leaves the region alone.
+    $custom = $this->createVariant('custom', [self::UUID_A => 'A']);
+    self::assertNull($this->drafts->get($this->key($custom, 'fr')));
+    self::assertNotNull($this->drafts->get($this->key($a, 'fr')));
+
+    // The variant Canvas builds from the theme's regions takes the draft.
+    $variant = $this->createThemeVariant([self::UUID_A => 'A']);
+    self::assertSame([$this->textKey(self::UUID_A) => 'A fr draft'], $this->drafts->get($this->key($variant, 'fr')));
+    self::assertNull($this->drafts->get($this->key($a, 'fr')));
+  }
+
+  /**
+   * The post update covers variants Canvas created before this module knew.
+   */
+  public function testPostUpdate(): void {
+    $a = $this->createRegion('sidebar_first', self::UUID_A, 'A');
+    $variant = $this->createThemeVariant([self::UUID_A => 'A']);
+    // The draft arrives after the variant exists, as on a site that updated
+    // Canvas first and kept translating regions with the old Canvas Translate.
+    $this->drafts->set($this->key($a, 'fr'), [$this->textKey(self::UUID_A) => 'A fr draft']);
+    $this->publish($a, 'fr', self::UUID_A, 'A fr live');
+
+    $this->container->get('module_handler')->loadInclude('canvas_translate', 'php', 'canvas_translate.post_update');
+    canvas_translate_post_update_0001_move_page_region_translations();
+
+    self::assertSame([$this->textKey(self::UUID_A) => 'A fr draft'], $this->drafts->get($this->key($variant, 'fr')));
+    self::assertNull($this->drafts->get($this->key($a, 'fr')));
+    self::assertSame('A fr live', $this->overrideTree($variant, 'fr')[self::UUID_A]['inputs']['text']);
+  }
+
+  /**
+   * Creates a page region in the default theme with one heading component.
+   *
+   * Goes through the entity type manager: the page region class is deprecated
+   * in Canvas 1.11, so we use the more generic ComponentTreeConfigEntityBase
+   * to not trigger deprecation warnings in the test.
+   */
+  private function createRegion(string $region, string $uuid, string $text, bool $enabled = TRUE): ComponentTreeConfigEntityBase {
+    $entity = $this->container->get('entity_type.manager')->getStorage('page_region')->create([
+      'theme' => $this->container->get('theme_handler')->getDefault(),
+      'region' => $region,
+      'component_tree' => [$this->heading($uuid, $text)],
+    ]);
+    \assert($entity instanceof ComponentTreeConfigEntityBase);
+    if ($enabled) {
+      $entity->enable();
+    }
+    $entity->save();
+    return $entity;
+  }
+
+  /**
+   * Creates the variant Canvas would build from the default theme's regions.
+   *
+   * @param array<string, string> $headings
+   *   Heading text keyed by component UUID.
+   */
+  private function createThemeVariant(array $headings): PageVariant {
+    $theme = $this->container->get('theme_handler')->getDefault();
+    return $this->createVariant(PageRegionTranslationUpgrade::VARIANT_ID_PREFIX . $theme, $headings);
+  }
+
+  /**
+   * Creates a page variant with the given headings and the content marker.
+   *
+   * @param string $id
+   *   The variant ID.
+   * @param array<string, string> $headings
+   *   Heading text keyed by component UUID.
+   */
+  private function createVariant(string $id, array $headings): PageVariant {
+    $tree = [
+      [
+        'uuid' => $this->container->get('uuid')->generate(),
+        'component_id' => Marker::PAGE_CONTENT_COMPONENT_ID,
+        'component_version' => self::MARKER_VERSION,
+        'inputs' => [],
+      ],
+    ];
+    foreach ($headings as $uuid => $text) {
+      $tree[] = $this->heading($uuid, $text);
+    }
+    $variant = PageVariant::create(['id' => $id, 'label' => $id, 'component_tree' => $tree]);
+    $variant->save();
+    return $variant;
+  }
+
+  /**
+   * A heading component instance for a component tree.
+   */
+  private function heading(string $uuid, string $text): array {
+    $component = Component::load('sdc.canvas_test_sdc.heading');
+    \assert($component instanceof Component);
+    return [
+      'uuid' => $uuid,
+      'component_id' => 'sdc.canvas_test_sdc.heading',
+      'component_version' => $component->getActiveVersion(),
+      'inputs' => ['text' => $text, 'element' => 'h3'],
+      'label' => "$text label",
+    ];
+  }
+
+  /**
+   * Writes a published translation for one heading's text.
+   */
+  private function publish(ComponentTreeConfigEntityBase $entity, string $langcode, string $uuid, string $text): void {
+    $override = $this->languageManager->getLanguageConfigOverride($langcode, $entity->getConfigDependencyName());
+    $tree = $override->get('component_tree') ?? [];
+    $tree[$uuid] = ['inputs' => ['text' => $text]];
+    $override->set('component_tree', $tree)->save();
+  }
+
+  /**
+   * The published translation tree of an entity in a language.
+   */
+  private function overrideTree(ComponentTreeConfigEntityBase $entity, string $langcode): array {
+    return $this->languageManager->getLanguageConfigOverride($langcode, $entity->getConfigDependencyName())->get('component_tree') ?? [];
+  }
+
+  /**
+   * A draft with its keys sorted, so tests do not depend on region order.
+   */
+  private function sorted(?array $draft): ?array {
+    if ($draft !== NULL) {
+      \ksort($draft);
+    }
+    return $draft;
+  }
+
+  /**
+   * The draft and approval key of an entity in a language.
+   */
+  private function key(ComponentTreeConfigEntityBase $entity, string $langcode): string {
+    return TranslationDraftStore::key($entity->getConfigDependencyName(), $langcode);
+  }
+
+  /**
+   * The draft key of a heading's text.
+   */
+  private function textKey(string $uuid): string {
+    return "component_tree.$uuid.inputs.text";
+  }
+
+  /**
+   * The draft key of a component's label.
+   */
+  private function labelKey(string $uuid): string {
+    return "component_tree.$uuid.label";
+  }
+
+}
