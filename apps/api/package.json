{
  "name": "api",
  "private": true,
  "portless": {
    "name": "api.next-hydra",
    "script": "dev:app"
  },
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless",
    "dev:app": "next dev --turbopack",
    "dev:public": "portless --ngrok",
    "start": "next start",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "next typegen && pnpm --workspace-root exec tsc --noEmit --project apps/api/tsconfig.json"
  },
  "dependencies": {
    "@repo/analytics": "workspace:*",
    "@repo/auth": "workspace:@repo/auth-workos@*",
    "@repo/commerce": "workspace:*",
    "@repo/commerce-provider": "workspace:@repo/commerce-commercetools@*",
    "@repo/design-system": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/payments": "workspace:*",
    "@repo/payments-stripe": "workspace:*",
    "@repo/registration": "workspace:*",
    "@repo/testing": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "effect": "catalog:",
    "import-in-the-middle": "2.0.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "require-in-the-middle": "8.0.1",
    "svix": "^1.66.0",
    "vitest": "catalog:",
    "workflow": "4.8.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.1.2",
    "typescript": "catalog:typescript7"
  }
}
