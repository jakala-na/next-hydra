@@ -32,6 +32,27 @@ function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null && !Array.isArray(value);
 }
 
+/**
+ * Mirrors CustomElementNormalizer's recursive key conversion so local previews
+ * receive the same nested prop shape as Canvas Headless.
+ */
+export function canonicalizeCanvasHeadlessPropValue(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(canonicalizeCanvasHeadlessPropValue);
+  }
+  if (!isRecord(value)) {
+    return value;
+  }
+  return Object.fromEntries(
+    Object.entries(value).map(([key, nestedValue]) => [
+      key.replace(/[_-]([a-z])/g, (_, letter: string) =>
+        letter.toUpperCase(),
+      ),
+      canonicalizeCanvasHeadlessPropValue(nestedValue),
+    ]),
+  );
+}
+
 function getContentEntityReferencePropTarget(
   prop: unknown,
 ): ContentEntityReferenceTarget | null {
