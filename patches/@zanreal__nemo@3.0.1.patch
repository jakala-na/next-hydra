new file mode 100644
index 0000000000000000000000000000000000000000..69a0ee3ab1964d9f5f7d55f076686da40d639550
--- /dev/null
+++ b/dist/carried-response-headers.js
@@ -0,0 +1,35 @@
+// Track explicit response headers alongside NEMO's existing request carrier.
+// Request overrides and routing controls must not become browser response headers.
+export function collectResponseHeaders(response, carried) {
+  for (const [name, value] of response.headers) {
+    // #184 continues to handle cookies, including multiple Set-Cookie fields.
+    if (name === "set-cookie" || name.startsWith("x-middleware-")) continue;
+    carried.set(name, value);
+  }
+}
+
+export function attachCarriedResponseHeaders(response, carried) {
+  if (!(response instanceof Response)) return response;
+  const additions = new Headers();
+  for (const [name, value] of carried) {
+    if (!response.headers.has(name)) {
+      // The terminating response is the latest writer and takes precedence.
+      additions.set(name, value);
+    }
+  }
+  if ([...additions].length === 0) return response;
+
+  try {
+    for (const [name, value] of additions) response.headers.set(name, value);
+    return response;
+  } catch {
+    // Native Response.redirect() has immutable headers, as in the cookie fix.
+    const headers = new Headers(response.headers);
+    for (const [name, value] of additions) headers.set(name, value);
+    return new Response(response.body, {
+      status: response.status,
+      statusText: response.statusText,
+      headers,
+    });
+  }
+}
