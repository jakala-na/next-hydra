{
  "extends": "@repo/typescript-config/effect.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@repo/auth": ["./node_modules/@repo/auth"],
      "@repo/auth/*": ["./node_modules/@repo/auth/*"],
      "@repo/commerce-provider": ["./node_modules/@repo/commerce-provider"],
