{
  "name": "next-hydra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakala-na/next-hydra"
  },
  "scripts": {
    "analyze": "turbo analyze",
    "boundaries": "turbo run boundaries",
    "build": "turbo build",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "clean": "git clean -xdf node_modules",
    "cli": "pnpm --filter cli cli",
    "dev": "turbo run dev",
    "dev:api:public": "turbo run dev:public --filter=api",
    "dev:without-api": "turbo run dev --filter=!api",
    "e2e:env:split": "node scripts/split-e2e-github-env.ts",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "publish:cli": "changeset publish",
    "registry:check": "node scripts/sync-registry-files.ts --check",
    "registry:sync": "node scripts/sync-registry-files.ts",
    "release:create-next-hydra": "node scripts/release-create-next-hydra.mjs",
    "release:create-next-hydra:dry-run": "node scripts/release-create-next-hydra.mjs --dry-run",
    "test": "turbo test",
    "test:e2e": "turbo run e2e",
    "test:e2e:affected": "turbo run e2e --affected",
    "translate": "turbo translate",
    "typecheck": "turbo typecheck",
    "version:cli": "changeset version"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "ultracite fix"
    ],
    "*.{json,jsonc,css,scss,md,mdx}": [
      "oxfmt --write"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.78.0",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.5.3",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:typescript7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "turbo": "2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.10.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "24.x"
  }
}
