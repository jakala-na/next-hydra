{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["typecheck"],
      "inputs": [
        "src/**",
        "scripts/clean-dist.js",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/typescript-config/**"
      ]
    },
    "test": { "dependsOn": [], "cache": false },
    "workspace:dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "workspace:build": { "dependsOn": ["build"], "cache": false },
    "workspace:sync": { "dependsOn": ["build"], "cache": false },
    "workspace:check": { "dependsOn": ["build"], "cache": false },
    "workspace:test": { "dependsOn": ["build"], "cache": false },
    "workspace:lint": { "dependsOn": ["build"], "cache": false },
    "workspace:typecheck": { "dependsOn": ["build"], "cache": false }
  }
}
