{
  "name": "create-next-hydra",
  "version": "0.3.0",
  "description": "CLI to compose customer-owned applications from the Next Hydra registry",
  "keywords": [
    "cli",
    "create-next-app",
    "create-next-hydra",
    "next-hydra",
    "scaffold",
    "starter",
    "turborepo"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakala-na/next-hydra",
    "directory": "packages/create-next-hydra"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-next-hydra": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.js",
    "build": "tsc6 -p tsconfig.json",
    "compose": "pnpm run build && node dist/cli.js compose",
    "pack": "npm pack",
    "prepublishOnly": "pnpm run build",
    "publish:dry-run": "npm publish --access public --dry-run",
    "publish:public": "npm publish --access public",
    "test": "NODE_ENV=test vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "NODE_ENV=test vitest run tests/e2e",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "workspace:dev": "node dist/cli.js compose storefront-contentstack --copy-env --run dev",
    "workspace:build": "node dist/cli.js compose --all --run build",
    "workspace:test": "node dist/test-reference-workspace.js",
    "workspace:lint": "node dist/lint-workspaces.js",
    "lint:staged": "pnpm run build && node dist/lint-workspaces.js --staged",
    "workspace:typecheck": "node dist/cli.js compose --all --run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "0.61.0",
    "shadcn": "^4.16.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
