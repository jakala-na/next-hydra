{
  "name": "create-next-hydra",
  "version": "0.1.0",
  "description": "CLI to scaffold a new next-hydra project",
  "keywords": [
    "cli",
    "create-next-app",
    "create-next-hydra",
    "next-hydra",
    "scaffold",
    "starter",
    "turborepo"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-next-hydra": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.js",
    "build": "tsc -p tsconfig.json",
    "pack": "npm pack",
    "prepublishOnly": "pnpm run build",
    "publish:dry-run": "npm publish --access public --dry-run",
    "publish:public": "npm publish --access public",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "shadcn": "^4.16.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
