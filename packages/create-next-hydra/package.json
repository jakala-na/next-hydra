{
  "name": "create-next-hydra",
  "version": "0.1.0",
  "description": "CLI to scaffold a new next-hydra project",
  "keywords": [
    "cli",
    "create-next-app",
    "create-next-hydra",
    "next-hydra",
    "scaffold",
    "starter",
    "turborepo"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-next-hydra": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "npm pack",
    "publish:dry-run": "npm publish --access public --dry-run",
    "publish:public": "npm publish --access public",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
