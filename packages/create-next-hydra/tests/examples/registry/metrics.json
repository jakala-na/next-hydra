  "meta": {
    "nextHydra": {
      "id": "example/add-on/metrics",
      "kind": "add-on",
      "packages": [
        {
          "cwd": "apps/web",
          "name": "site-metrics",
          "specifier": "^2",
          "section": "dependencies"
        }
      ]
    }
  }
}
