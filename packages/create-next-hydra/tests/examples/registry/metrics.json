{
  "name": "site-metrics",
  "type": "registry:item",
  "files": [
    {
      "path": "web/package.json",
      "target": "~/apps/web/package.json",
      "type": "registry:file",
      "content": "{\"name\":\"web\",\"scripts\":{\"report\":\"metrics report\"},\"dependencies\":{\"existing\":\"^1\"}}\n"
    }
