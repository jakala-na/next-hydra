{
  "homepage": "https://example.com",
  "name": "example",
  "items": [
    {
      "name": "editorial",
      "type": "registry:item",
      "registryDependencies": ["web"],
      "files": [
        {
          "path": "article.ts",
          "target": "~/apps/web/article.ts",
          "type": "registry:file"
        }
      ],
      "meta": {
        "nextHydra": {
          "id": "example/cms/editorial",
          "kind": "provider",
          "slot": "cms",
          "binding": {
            "specifier": "workspace:@example/editorial@*"
          }
        },
        "composition": {
          "slotBindings": [
            {
              "target": "apps/web/blocks.ts",
              "slot": "blocks",
              "module": "./article",
              "export": "article"
            }
          ]
        }
      }
    },
    {
      "name": "web",
      "type": "registry:item",
      "meta": {
        "composition": {
          "templates": [
            {
              "source": "blocks.ts.template",
              "target": "apps/web/blocks.ts",
              "slots": {
                "blocks": "members"
              }
            }
          ]
        }
      }
    },
    {
      "name": "unselected",
      "type": "registry:item",
      "files": [
        {
          "path": "absent.ts",
          "target": "~/apps/web/absent.ts",
          "type": "registry:file"
        }
      ]
    },
    {
      "name": "app-web",
      "type": "registry:item",
      "meta": {
        "nextHydra": {
          "id": "example/app/web",
          "kind": "package"
        }
      }
    }
  ]
}
