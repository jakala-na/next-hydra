{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
  "title": "Next Hydra Selection Definition",
  "description": "A ShadCN registry item containing strict Next Hydra composition metadata.",
  "allOf": [
    {
      "$ref": "https://ui.shadcn.com/schema/registry-item.json"
    },
    {
      "type": "object",
      "required": ["$schema", "meta"],
      "properties": {
        "$schema": {
          "const": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json"
        },
        "meta": {
          "type": "object",
          "required": ["nextHydra"],
          "properties": {
            "composition": {
              "$ref": "#/$defs/composition"
            },
            "nextHydra": {
              "$ref": "#/$defs/nextHydra"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "slots"],
            "properties": {
              "source": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "slots": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "element",
                    "wrapper",
                    "call",
                    "factory",
                    "members",
                    "graphql"
                  ]
                }
              }
            }
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "slot", "module", "export"],
            "properties": {
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w$]*$"
              },
              "as": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w$]*$"
              },
              "order": {
                "type": "integer",
                "default": 0
              }
            }
          }
        }
      }
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "workspaceFilePath": {
      "allOf": [
        {
          "$ref": "#/$defs/workspacePath"
        },
        {
          "not": {
            "pattern": "^\\.(?:/+\\.)*/*$"
          }
        }
      ]
    },
    "nextHydra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "provider",
            "add-on",
            "preset",
            "contribution",
            "package",
            "integration"
          ]
        },
        "maintainerWorkspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copy": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "slot": {
          "enum": ["auth", "cms", "commerce"]
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specifier"],
          "properties": {
            "specifier": {
              "type": "string",
              "minLength": 1
            },
            "sourcePath": {
              "$ref": "#/$defs/workspaceFilePath"
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd", "section", "name", "specifier"],
            "properties": {
              "cwd": {
                "$ref": "#/$defs/workspacePath"
              },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": ["@repo/auth", "@repo/cms", "@repo/commerce-provider"]
                }
              },
              "specifier": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "providerDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd", "section", "slot"],
            "properties": {
              "cwd": {
                "$ref": "#/$defs/workspacePath"
              },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies"
                ]
              },
              "slot": {
                "enum": ["auth", "cms", "commerce"]
              }
            }
          }
        },
        "providerSlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auth": {
              "enum": ["optional", "required", "forbidden"]
            },
            "cms": {
              "enum": ["optional", "required", "forbidden"]
            },
            "commerce": {
              "enum": ["optional", "required", "forbidden"]
            }
          }
        },
        "pnpmPatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dependency", "path"],
            "properties": {
              "dependency": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "typeScriptAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "cwd", "sourcePath"],
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "$ref": "#/$defs/workspaceRelativePath"
              },
              "sourcePath": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "selections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "auth": {
                  "type": "string",
                  "minLength": 1
                },
                "cms": {
                  "type": "string",
                  "minLength": 1
                },
                "commerce": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "addOns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "conditionalDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providers", "items"],
            "properties": {
              "providers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["auth", "cms", "commerce"]
                }
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provider"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["binding", "slot"],
            "not": {
              "required": ["selections"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "add-on"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["slot"]
                },
                {
                  "required": ["binding"]
                },
                {
                  "required": ["selections"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "preset"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["selections"],
            "not": {
              "anyOf": [
                {
                  "required": ["slot"]
                },
                {
                  "required": ["binding"]
                },
                {
                  "properties": {
                    "providerDependencies": {
                      "minItems": 1
                    }
                  },
                  "required": ["providerDependencies"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
