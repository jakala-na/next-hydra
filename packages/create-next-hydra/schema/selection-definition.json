{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
  "title": "Next Hydra Selection Definition",
  "description": "A ShadCN registry item containing strict Next Hydra composition metadata.",
  "allOf": [
    {
      "$ref": "https://ui.shadcn.com/schema/registry-item.json"
    },
    {
      "type": "object",
      "required": ["$schema", "meta"],
      "properties": {
        "$schema": {
          "const": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json"
        },
        "meta": {
          "type": "object",
          "required": ["nextHydra"],
          "properties": {
            "composition": {
              "$ref": "#/$defs/composition"
            },
            "nextHydra": {
              "$ref": "#/$defs/nextHydra"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "composerRequirements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[a-z0-9_.-]+/[a-z0-9_.-]+|php(?:-64bit|-ipv6|-zts|-debug)?|hhvm|(?:ext|lib)-[a-z0-9](?:[_.-]?[a-z0-9]+)*|composer(?:-(?:plugin|runtime)-api)?)$"
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "slots"],
            "properties": {
              "source": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "slots": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "element",
                    "wrapper",
                    "call",
                    "factory",
                    "members",
                    "graphql"
                  ]
                }
              }
            }
          }
        },
        "slotBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "slot", "module", "export"],
            "properties": {
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w$]*$"
              },
              "as": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w$]*$"
              },
              "order": {
                "type": "integer",
                "default": 0
              }
            }
          }
        }
      }
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "workspaceFilePath": {
      "allOf": [
        {
          "$ref": "#/$defs/workspacePath"
        },
        {
          "not": {
            "pattern": "^\\.(?:/+\\.)*/*$"
          }
        }
      ]
    },
    "nextHydra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "composer": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd"],
            "properties": {
              "cwd": { "$ref": "#/$defs/workspacePath" },
              "require": { "$ref": "#/$defs/composerRequirements" },
              "require-dev": { "$ref": "#/$defs/composerRequirements" },
              "repositories": {
                "type": "object",
                "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$" },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "url"],
                      "properties": {
                        "canonical": { "type": "boolean" },
                        "only": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "exclude": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "type": { "const": "path" },
                        "url": {
                          "allOf": [
                            { "$ref": "#/$defs/workspaceFilePath" },
                            { "pattern": "^(?!~)(?!.*(?:\\$|%[^%]+%)).+$" }
                          ]
                        },
                        "options": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "symlink": { "type": "boolean" },
                            "reference": { "enum": ["none", "config", "auto"] },
                            "versions": {
                              "type": "object",
                              "propertyNames": {
                                "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
                              },
                              "additionalProperties": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "url"],
                      "properties": {
                        "canonical": { "type": "boolean" },
                        "only": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "exclude": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "type": { "const": "composer" },
                        "url": {
                          "type": "string",
                          "pattern": "^https://[^@\\s/?#]+(?:[/?#][^\\s]*)?$"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type", "url"],
                      "properties": {
                        "canonical": { "type": "boolean" },
                        "only": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "exclude": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "type": { "enum": ["vcs", "git"] },
                        "url": {
                          "type": "string",
                          "anyOf": [
                            {
                              "pattern": "^https://[^@\\s/?#]+(?:[/?#][^\\s]*)?$"
                            },
                            {
                              "pattern": "^ssh://(?:[a-zA-Z0-9._-]+@)?[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::[0-9]+)?/[^\\s?#]+$"
                            },
                            {
                              "pattern": "^[a-zA-Z0-9._-]+@[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?:[^\\s?#]+$"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["provider", "add-on", "preset", "package", "recipe"]
        },
        "slot": {
          "enum": ["auth", "cms", "commerce", "search"]
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specifier"],
          "properties": {
            "specifier": {
              "type": "string",
              "minLength": 1
            },
            "sourcePath": {
              "$ref": "#/$defs/workspaceFilePath"
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd", "section", "name", "specifier"],
            "properties": {
              "cwd": {
                "$ref": "#/$defs/workspacePath"
              },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "@repo/auth",
                    "@repo/cms",
                    "@repo/commerce-provider",
                    "@repo/search-provider"
                  ]
                }
              },
              "specifier": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "providerDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cwd", "section", "slot"],
            "properties": {
              "cwd": {
                "$ref": "#/$defs/workspacePath"
              },
              "section": {
                "enum": [
                  "dependencies",
                  "devDependencies",
                  "optionalDependencies"
                ]
              },
              "slot": {
                "enum": ["auth", "cms", "commerce", "search"]
              }
            }
          }
        },
        "providerSlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auth": {
              "enum": ["optional", "required", "forbidden"]
            },
            "cms": {
              "enum": ["optional", "required", "forbidden"]
            },
            "commerce": {
              "enum": ["optional", "required", "forbidden"]
            },
            "search": {
              "enum": ["optional", "required", "forbidden"]
            }
          }
        },
        "pnpmPatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dependency", "path"],
            "properties": {
              "dependency": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "typeScriptAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "cwd", "sourcePath"],
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "$ref": "#/$defs/workspaceRelativePath"
              },
              "sourcePath": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": {
                "$ref": "#/$defs/workspaceFilePath"
              },
              "target": {
                "$ref": "#/$defs/workspaceFilePath"
              }
            }
          }
        },
        "selections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "auth": {
                  "type": "string",
                  "minLength": 1
                },
                "cms": {
                  "type": "string",
                  "minLength": 1
                },
                "commerce": {
                  "type": "string",
                  "minLength": 1
                },
                "search": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "addOns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "conditionalDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providers", "items"],
            "properties": {
              "providers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["auth", "cms", "commerce", "search"]
                }
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provider"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["binding", "slot"],
            "not": {
              "required": ["selections"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "add-on"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["slot"]
                },
                {
                  "required": ["binding"]
                },
                {
                  "required": ["selections"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "preset"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["selections"],
            "not": {
              "anyOf": [
                {
                  "required": ["slot"]
                },
                {
                  "required": ["binding"]
                },
                {
                  "properties": {
                    "providerDependencies": {
                      "minItems": 1
                    }
                  },
                  "required": ["providerDependencies"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
