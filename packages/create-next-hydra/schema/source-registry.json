{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "title": "Next Hydra Source Registry",
  "description": "A ShadCN source registry that applies the Next Hydra Selection Definition schema to items containing meta.nextHydra.",
  "allOf": [
    {
      "$ref": "https://ui.shadcn.com/schema/registry.json"
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "if": {
              "type": "object",
              "required": ["meta"],
              "properties": {
                "meta": {
                  "type": "object",
                  "required": ["nextHydra"]
                }
              }
            },
            "then": {
              "$ref": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json"
            },
            "else": {
              "$ref": "https://ui.shadcn.com/schema/registry-item.json"
            }
          }
        }
      }
    }
  ]
}
