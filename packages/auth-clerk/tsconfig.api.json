{
  "extends": "@repo/typescript-config/effect-nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../../apps/api/*"],
      "@repo/auth": ["./"],
      "@repo/auth/*": ["./*"],
      "@repo/commerce-provider": [
        "../../apps/api/node_modules/@repo/commerce-provider"
      ],
      "@repo/commerce-provider/*": [
        "../../apps/api/node_modules/@repo/commerce-provider/*"
      ],
      "@repo/*": ["../*"]
    }
  },
  "include": [
    "../../apps/api/next-env.d.ts",
    "../../apps/api/next.config.ts",
    "../../apps/api/**/*.d.ts",
    "../../apps/api/**/*.ts",
    "../../apps/api/**/*.tsx",
    "registry/apps/api/**/*.ts"
  ],
  "exclude": [
    "../../apps/api/.next",
    "../../apps/api/app/api/webhooks/workos",
    "../../apps/api/node_modules"
  ]
}
