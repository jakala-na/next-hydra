{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "auth-clerk",
      "type": "registry:item",
      "title": "Next Hydra Clerk Auth provider",
      "description": "Installs the Clerk Auth provider package and component-backed authentication routes.",
      "docs": "Configure Clerk, CLERK_AUTHORIZED_PARTIES, and CLERK_WEBHOOK_SECRET before starting the applications. In Clerk, register the generated /api/webhooks/clerk endpoint for user.created events. Registration approvals issue application invitations that redirect to /accept-invitation, where Clerk's SignIn component consumes the invitation ticket. Application-initiated revocations publish the registration workflow event after Clerk confirms the invitation is revoked.",
      "registryDependencies": [
        "jakala-na/next-hydra/auth-contract"
      ],
      "meta": {
        "nextHydra": {
          "id": "next-hydra/auth/clerk",
          "kind": "provider",
          "slot": "auth",
          "packages": [
            {
              "cwd": "apps/api",
              "section": "dependencies",
              "name": "@repo/auth",
              "specifier": "workspace:@repo/auth-clerk@*"
            },
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "name": "@repo/auth",
              "specifier": "workspace:@repo/auth-clerk@*"
            },
            {
              "cwd": "packages/feature-flags",
              "section": "dependencies",
              "name": "@repo/auth",
              "specifier": "workspace:@repo/auth-clerk@*"
            }
          ]
        }
      },
      "files": [
