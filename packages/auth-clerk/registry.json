  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "auth-clerk",
      "type": "registry:item",
      "title": "Next Hydra Clerk Auth provider",
      "description": "Installs the Clerk Auth provider package and component-backed authentication routes.",
      "docs": "Configure customer Clerk authentication in apps/web and keep session cookies host-only. When Commerce is selected, its identity recipe adds administration and customer webhook setup. See packages/auth-clerk/README.md.",
      "registryDependencies": ["auth-contract", "auth-web"],
      "meta": {
        "nextHydra": {
          "id": "next-hydra/auth/clerk",
          "kind": "provider",
          "slot": "auth",
          "binding": {
            "specifier": "workspace:@repo/auth-clerk@*",
            "sourcePath": "packages/auth-clerk"
          },
          "conditionalDependencies": [
            { "providers": ["commerce"], "items": ["auth-clerk-commerce"] }
          ]
        },
        "setup": {
          "group": "auth",
          "title": "Identity · Clerk",
          "order": 20,
          "steps": [
            {
              "id": "auth.configure",
              "title": "Configure customer access",
              "order": 10,
              "detail": "Configure Clerk credentials for apps/web and its actual origin. Keep cookies host-only. See packages/auth-clerk/README.md."
            }
          ]
        }
      },
      "files": [
