{
  "name": "@repo/auth-clerk",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "prototype:svix": "node --env-file-if-exists=.env.local --experimental-strip-types prototypes/svix-provisioning/cli.ts",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --project packages/auth-clerk/tsconfig.json",
    "typecheck:composition": "pnpm --workspace-root exec tsc --noEmit --project packages/auth-clerk/tsconfig.web.json && pnpm --workspace-root exec tsc --noEmit --project packages/auth-clerk/tsconfig.admin.json && pnpm --workspace-root exec tsc --noEmit --project packages/auth-clerk/tsconfig.api.json && pnpm --workspace-root exec tsc --noEmit --project packages/auth-clerk/tsconfig.feature-flags.json"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "@repo/analytics": "workspace:*",
    "@repo/auth-contract": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/registration": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "svix": "^1.84.1",
    "zod": "^3.25.28"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "next": "catalog:"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/shared": "^4.30.2",
    "@clerk/testing": "^2.2.23",
    "@repo/e2e-testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
