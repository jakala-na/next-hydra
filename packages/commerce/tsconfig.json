{
  "extends": "@repo/typescript-config/effect-nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "includeSuggestionsInTsc": false
      }
    ],
    "paths": {
      "@repo/commerce/*": ["./*"],
      "@repo/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
