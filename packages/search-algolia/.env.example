ALGOLIA_APPLICATION_ID=""
ALGOLIA_SEARCH_API_KEY=""
# Optional namespace for Product, Content, and Query Suggestions indices.
# ALGOLIA_INDEX_PREFIX="development"

# Bootstrap-only inputs for `pnpm --filter cli cli search provision`. Never expose these keys to a browser.
ALGOLIA_ADMIN_API_KEY=""
ALGOLIA_REGION="us"

# Content search app installation (`pnpm --filter cli cli search provision
# --install-content-search-app`, Contentstack compositions only).
# Algolia API key with write access to the Content index, consumed by the CMS
# provider's installer. Contentstack connection details live in the CMS
# package's .env.example.
ALGOLIA_CONTENT_WRITE_API_KEY=""
