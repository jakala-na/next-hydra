# Commercetools Configuration
COMMERCETOOLS_PROJECT_KEY=your-project-key
COMMERCETOOLS_CLIENT_ID=your-client-id
COMMERCETOOLS_CLIENT_SECRET=your-client-secret
COMMERCETOOLS_SCOPE=manage_project:your-project-key
COMMERCETOOLS_REGION=us-central1.gcp

# Standard Commercetools API Client input for one-time project provisioning
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_SECRET=your-bootstrap-client-secret
CTP_CLIENT_ID=your-bootstrap-client-id
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
CTP_SCOPES=manage_project_settings:your-project-key manage_api_clients:your-project-key
