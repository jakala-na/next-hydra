{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "cms-contentstack",
      "type": "registry:item",
      "title": "Next Hydra Contentstack CMS provider",
      "description": "Installs the Contentstack CMS provider package.",
      "docs": "Configure the Contentstack environment variables described by packages/cms-contentstack before starting the web application.",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/cms/contentstack",
          "kind": "provider",
          "slot": "cms",
          "installUnits": [
            {
              "item": "cms-contentstack",
              "cwd": "packages/cms-contentstack"
            }
          ],
          "packages": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "name": "@repo/cms",
              "specifier": "workspace:@repo/cms-contentstack@*"
            }
          ],
          "routes": [
            {
              "app": "apps/web",
              "path": "/api/draft",
              "method": "GET",
              "module": "@repo/cms/routes/draft",
              "export": "GET"
            },
            {
              "app": "apps/web",
              "path": "/api/disable-draft",
              "method": "GET",
              "module": "@repo/cms/routes/disable-draft",
              "export": "GET"
            }
          ]
        }
      },
      "files": [
        {
          "path": ".env.example",
          "target": "~/.env.example",
          "type": "registry:file"
        },
        {
          "path": "client.ts",
          "target": "~/client.ts",
          "type": "registry:file"
        },
        {
          "path": "components/blocks/dynamic-product-collection.tsx",
          "target": "~/components/blocks/dynamic-product-collection.tsx",
          "type": "registry:file"
        },
        {
          "path": "components/blocks/hero-section.tsx",
          "target": "~/components/blocks/hero-section.tsx",
          "type": "registry:file"
        },
        {
