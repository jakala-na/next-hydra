    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "auth-workos-commerce",
      "type": "registry:item",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/recipe/auth-workos-commerce",
          "kind": "recipe",
          "packages": [
            {
              "cwd": "packages/auth-workos",
              "name": "@repo/registration",
              "specifier": "workspace:*",
              "section": "dependencies"
            }
          ]
        },
        "setup": {
          "group": "auth",
          "title": "Identity · WorkOS",
          "order": 20,
          "steps": [
            {
              "id": "auth.admin",
              "title": "Configure administration access",
              "order": 15,
              "detail": "Use a separate WorkOS project for apps/admin. Configure its credentials in apps/admin and the matching ADMIN_WORKOS_* credentials in apps/api. See packages/auth-workos/README.md."
            },
            {
              "id": "auth.provision",
              "title": "Register the customer webhook",
              "order": 20,
              "detail": "Use the customer provider credentials and your public API URL.",
              "commands": [
                "pnpm --filter cli cli auth provision \\\n  --api-url <api-url> --output auth.env"
              ]
            }
          ]
        }
      },
      "title": "WorkOS Commerce identity recipe",
      "files": [
