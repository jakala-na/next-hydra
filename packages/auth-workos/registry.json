{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "auth-workos",
      "type": "registry:item",
      "title": "Next Hydra WorkOS Auth provider",
      "description": "Installs the WorkOS AuthKit provider package.",
      "docs": "Configure customer WorkOS authentication in apps/web and keep session cookies host-only. When Commerce is selected, its identity recipe adds administration and customer webhook setup. See packages/auth-workos/README.md.",
      "registryDependencies": ["auth-contract", "auth-web"],
      "meta": {
        "nextHydra": {
          "id": "next-hydra/auth/workos",
          "kind": "provider",
          "slot": "auth",
          "binding": {
            "specifier": "workspace:@repo/auth-workos@*",
            "sourcePath": "packages/auth-workos"
          },
          "conditionalDependencies": [
            { "providers": ["commerce"], "items": ["auth-workos-commerce"] }
          ]
        },
        "setup": {
          "group": "auth",
          "title": "Identity · WorkOS",
          "order": 20,
          "steps": [
            {
              "id": "auth.configure",
              "title": "Configure customer access",
              "order": 10,
              "detail": "Configure WorkOS credentials for apps/web and its actual origin. Keep cookies host-only. See packages/auth-workos/README.md."
            }
          ]
        }
      },
      "files": [
