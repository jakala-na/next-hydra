{
  "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/source-registry.json",
  "items": [
    {
      "$schema": "https://raw.githubusercontent.com/jakala-na/next-hydra/main/packages/create-next-hydra/schema/selection-definition.json",
      "name": "cms-drupal",
      "type": "registry:item",
      "title": "Next Hydra Drupal CMS provider",
      "description": "Installs the Drupal CMS provider package and its Drupal sidecar application.",
      "docs": "Install and enable the Drupal recipe, then configure the Drupal and Canvas environment variables described by packages/cms-drupal and apps/drupal-hydra.",
      "meta": {
        "nextHydra": {
          "id": "next-hydra/cms/drupal",
          "kind": "provider",
          "slot": "cms",
          "installUnits": [
            {
              "item": "cms-drupal",
              "cwd": "packages/cms-drupal"
            },
            {
              "item": "drupal-hydra",
              "cwd": "apps/drupal-hydra"
            }
          ],
          "packages": [
            {
              "cwd": "apps/web",
              "section": "dependencies",
              "name": "@repo/cms",
              "specifier": "workspace:@repo/cms-drupal@*"
            }
          ],
          "assets": [
            {
              "source": "patches/@drupal-canvas__headless-next.patch",
              "target": "patches/@drupal-canvas__headless-next.patch"
            },
            {
              "source": "patches/@drupal-canvas__headless-react.patch",
              "target": "patches/@drupal-canvas__headless-react.patch"
            },
            {
              "source": "patches/@drupal-canvas__headless.patch",
              "target": "patches/@drupal-canvas__headless.patch"
            },
            {
              "source": "apps/drupal-hydra/recipes/next-hydra-starter/content/file/next-hydra-hero.webp",
              "target": "apps/drupal-hydra/recipes/next-hydra-starter/content/file/next-hydra-hero.webp"
            }
          ],
          "pnpmPatches": [
            {
              "dependency": "@drupal-canvas/headless",
              "path": "patches/@drupal-canvas__headless.patch"
            },
            {
              "dependency": "@drupal-canvas/headless-next",
              "path": "patches/@drupal-canvas__headless-next.patch"
            },
            {
              "dependency": "@drupal-canvas/headless-react",
              "path": "patches/@drupal-canvas__headless-react.patch"
            }
          ],
          "routes": [
            {
              "app": "apps/web",
              "path": "/api/canvas/components",
              "method": "GET",
              "module": "@repo/cms/routes/canvas",
              "export": "getCanvasComponents"
            },
            {
              "app": "apps/web",
              "path": "/api/canvas/components",
              "method": "OPTIONS",
              "module": "@repo/cms/routes/canvas",
              "export": "optionsCanvasComponents"
            },
            {
              "app": "apps/web",
              "path": "/api/disable-draft",
              "method": "POST",
              "module": "@repo/cms/routes/canvas",
              "export": "disableCanvasDraft"
            },
            {
              "app": "apps/web",
              "path": "/api/disable-drupal-preview",
              "method": "GET",
              "module": "@repo/cms/routes/disable-draft",
              "export": "GET"
            },
            {
              "app": "apps/web",
              "path": "/api/draft",
              "method": "GET",
              "module": "@repo/cms/routes/canvas",
              "export": "enableCanvasDraft"
            },
            {
              "app": "apps/web",
              "path": "/api/draft/renew",
              "method": "POST",
              "module": "@repo/cms/routes/canvas",
              "export": "renewCanvasDraft"
            },
            {
              "app": "apps/web",
              "path": "/api/drupal-preview",
              "method": "GET",
              "module": "@repo/cms/routes/draft",
              "export": "GET"
            }
          ]
        }
      },
