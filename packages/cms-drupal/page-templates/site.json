{
  "label": "Site",
  "description": "Shared content around the application header, page and footer.",
  "status": true,
  "default": false,
  "elements": {
    "shell": {
      "type": "js.site-shell",
      "slots": {
        "preHeader": ["preHeader"],
        "postHeader": ["postHeader"],
        "content": ["content"],
        "preFooter": ["preFooter"],
        "postFooter": ["postFooter"]
      }
    },
    "preHeader": {
      "type": "js.text",
      "props": {
        "text": "Global pre-header region"
      }
    },
    "postHeader": {
      "type": "js.text",
      "props": {
        "text": "Global post-header region"
      }
    },
    "content": {
      "type": "marker.page_content"
    },
    "preFooter": {
      "type": "js.text",
      "props": {
        "text": "Global pre-footer region"
      }
    },
    "postFooter": {
      "type": "js.text",
      "props": {
        "text": "Global post-footer region"
      }
    }
  }
}
