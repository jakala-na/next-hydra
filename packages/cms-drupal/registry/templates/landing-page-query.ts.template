import { graphql } from "../../graphql";
{{imports}}

export const landingPageFragment = graphql(
  `
    fragment DrupalLandingPage on NodeLandingPage {
      __typename
      id
      title
      displayTitle
      hideDisplayTitle
      components {
        __typename
        ... on ParagraphInterface {
          id
        }
        {{pageBlocks.spreads}}
      }
    }
  `,
  [{{pageBlocks.documents}}]
);
