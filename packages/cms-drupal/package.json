{
  "name": "@repo/cms-drupal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cli": "./cli/index.ts",
    "./canvas-component-props": "./generated/canvas-component-props.ts",
    "./client": "./client.ts",
    "./components/live-preview": "./components/live-preview.tsx",
    "./components/page": "./components/page.tsx",
    "./components/pages/landing-page": "./components/pages/landing-page.tsx",
    "./graphql": "./graphql.ts",
    "./keys": "./keys.ts",
    "./layout": "./layout.tsx",
    "./lib/latest-articles": "./lib/latest-articles.ts",
    "./lib/navigation": "./lib/navigation/index.ts",
    "./next-config": "./next-config.ts",
    "./proxy": "./proxy.ts",
    "./search": "./search.ts",
    "./security": "./security.ts",
    "./routes/canvas": "./routes/canvas.ts",
    "./routes/disable-draft": "./routes/disable-draft.ts",
    "./routes/draft": "./routes/draft.ts",
    "./typescript-config.json": "./typescript-config.json"
  },
  "scripts": {
    "canvas:build": "pnpm run canvas:css && canvas build",
    "canvas:css": "node scripts/build-canvas-css.mjs",
    "canvas:push": "pnpm run canvas:css && canvas push --no-pages --no-content-templates --no-page-templates",
    "canvas:registry": "node scripts/generate-canvas-component-registry.mjs",
    "canvas:typegen": "node scripts/generate-canvas-component-types.mjs",
    "canvas:typegen:check": "node scripts/generate-canvas-component-types.mjs --check",
    "canvas:validate": "pnpm run canvas:css && canvas validate",
    "canvas:workbench": "pnpm run canvas:css && canvas-workbench --config scripts/canvas-workbench.config.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "generate": "node --use-system-ca scripts/gql-sync.ts",
    "lint:prepare": "pnpm run canvas:registry",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit --project packages/cms-drupal/tsconfig.json"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.9.0",
    "@drupal-canvas/headless-next": "^0.6.1",
    "@drupal-canvas/headless-react": "^0.4.3",
    "@repo/commerce": "workspace:*",
    "@repo/demo-architecture": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/search": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "@urql/core": "^5.1.2",
    "effect": "catalog:",
    "gql.tada": "^1.8.10",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@drupal-canvas/cli": "^0.25.2",
    "@drupal-canvas/workbench": "^0.12.0",
    "@gql.tada/cli-utils": "^1.6.3",
    "@repo/e2e-testing": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv": "^17.0.0",
    "playwright-bdd": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
