DRUPAL_BASE_URL=https://drupal-hydra.ddev.site:8443
# Optional Canvas endpoint override. Defaults to DRUPAL_BASE_URL.
CANVAS_SITE_URL=
# Optional comma-separated editor origins for framing. Defaults to CANVAS_SITE_URL.
# Leave unset to use the default; an explicitly empty value allows only the frontend itself.
# CANVAS_EDITOR_ORIGINS=https://cms.example.com
# Optional endpoint overrides. Defaults are <base>/oauth/token and <base>/graphql.
DRUPAL_AUTH_URI=
DRUPAL_GRAPHQL_URI=
DRUPAL_PREVIEWER_CLIENT_ID=
DRUPAL_PREVIEWER_CLIENT_SECRET=
DRUPAL_VIEWER_CLIENT_ID=
DRUPAL_VIEWER_CLIENT_SECRET=
