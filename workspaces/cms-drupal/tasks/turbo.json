        "$TURBO_ROOT$/packages/**/registry.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/create-next-hydra/schema/**",
        "$TURBO_ROOT$/packages/create-next-hydra/scripts/**",
        "$TURBO_ROOT$/apps/cli/**",
        "$TURBO_ROOT$/apps/drupal/**",
        "$TURBO_ROOT$/apps/web/**",
        "$TURBO_ROOT$/packages/analytics/**",
        "$TURBO_ROOT$/packages/cms-drupal/**",
        "$TURBO_ROOT$/packages/design-system/**",
        "$TURBO_ROOT$/packages/email/**",
        "$TURBO_ROOT$/packages/errors/**",
        "$TURBO_ROOT$/packages/i18n/**",
        "$TURBO_ROOT$/packages/next-config/**",
        "$TURBO_ROOT$/packages/observability/**",
        "$TURBO_ROOT$/packages/rate-limit/**",
        "$TURBO_ROOT$/packages/security/**",
        "$TURBO_ROOT$/packages/seo/**",
        "$TURBO_ROOT$/packages/testing/**",
        "$TURBO_ROOT$/packages/typescript-config/**",
        "$TURBO_ROOT$/patches/@drupal-canvas__headless-next.patch",
        "$TURBO_ROOT$/patches/@drupal-canvas__headless-react.patch",
        "$TURBO_ROOT$/patches/@drupal-canvas__headless.patch",
        "$TURBO_ROOT$/patches/@drupal-canvas__workbench@0.10.0.patch",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.cache/**",
        "!$TURBO_ROOT$/**/.swc/**",
        "!$TURBO_ROOT$/**/.vercel/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/.workflow-data/**",
        "!$TURBO_ROOT$/**/.env",
        "!$TURBO_ROOT$/**/.env.local",
        "!$TURBO_ROOT$/**/.env.*.local",
        "!$TURBO_ROOT$/**/*.tsbuildinfo"
      ],
      "outputs": []
