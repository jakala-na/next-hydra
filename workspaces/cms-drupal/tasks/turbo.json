{
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/workspaces/cms-drupal/next-hydra.json",
        "$TURBO_ROOT$/workspaces/cms-drupal/apps/*/vercel.json",
        "$TURBO_ROOT$/*",
