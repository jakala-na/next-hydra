{
  "envMode": "loose",
  "futureFlags": { "affectedUsingTaskInputs": true },
  "globalEnv": [
    "ANALYZE",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_*",
    "ALGOLIA_PRICE_CUSTOMER_GROUP_IDS",
    "CTP_PROJECT_KEY",
    "CTP_CLIENT_ID",
    "CTP_CLIENT_SECRET",
    "CTP_AUTH_URL",
    "CTP_API_URL",
    "CTP_SCOPES",
    "ALGOLIA_APPLICATION_ID",
    "ALGOLIA_SEARCH_API_KEY",
    "ALGOLIA_ADMIN_API_KEY",
    "ALGOLIA_REGION",
    "ALGOLIA_CONTENT_WRITE_API_KEY",
    "LANGUINE_PROJECT_ID",
    "COMMERCETOOLS_PROJECT_KEY",
    "COMMERCETOOLS_CLIENT_ID",
    "COMMERCETOOLS_CLIENT_SECRET",
    "COMMERCETOOLS_SCOPE",
    "COMMERCETOOLS_REGION",
    "DRUPAL_BASE_URL",
    "CANVAS_SITE_URL",
    "CANVAS_JSONAPI_PREFIX",
    "DRUPAL_AUTH_URI",
    "DRUPAL_GRAPHQL_URI",
    "DRUPAL_PREVIEWER_CLIENT_ID",
    "DRUPAL_PREVIEWER_CLIENT_SECRET",
    "DRUPAL_VIEWER_CLIENT_ID",
    "DRUPAL_VIEWER_CLIENT_SECRET",
    "NEXT_PUBLIC_WEB_URL",
    "CMS_HOMEPAGE_SLUG",
    "CMS_REVALIDATION_SECRET",
    "FRAME_ANCESTORS",
    "ADMIN_URL",
    "RESEND_FROM",
    "RESEND_TOKEN",
    "FLAGS_SECRET",
    "ARCJET_KEY",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "WORKOS_WEBHOOK_SECRET",
    "CLERK_AUTHORIZED_PARTIES",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "ADMIN_WORKOS_API_KEY",
    "ADMIN_WORKOS_CLIENT_ID",
    "ADMIN_CLERK_AUTHORIZED_PARTIES",
    "ADMIN_CLERK_PUBLISHABLE_KEY",
    "ADMIN_CLERK_SECRET_KEY",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_API_URL",
    "WORKOS_COOKIE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "test"],
      "env": [
        "VERCEL_PROJECT_PRODUCTION_URL",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN"
      ],
      "inputs": [
        "**/*",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.next/**",
        "!**/.turbo/**",
        "!**/.cache/**",
        "!**/.swc/**",
        "!**/.vercel/**",
        "!**/.git/**",
        "!**/coverage/**",
        "!**/.features-gen/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!**/.workflow-data/**",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "!next.config.compiled.js",
        "!app/.well-known/workflow/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["PORTLESS_*"],
      "persistent": true
    },
    "e2e": { "cache": false },
    "e2e:list": { "cache": false },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "**/*",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.next/**",
        "!**/.turbo/**",
        "!**/.cache/**",
        "!**/.swc/**",
        "!**/.vercel/**",
        "!**/.git/**",
        "!**/coverage/**",
        "!**/.features-gen/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!**/.workflow-data/**",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "!next.config.compiled.js",
        "!app/.well-known/workflow/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "**/*",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.next/**",
        "!**/.turbo/**",
        "!**/.cache/**",
        "!**/.swc/**",
        "!**/.vercel/**",
        "!**/.git/**",
        "!**/coverage/**",
        "!**/.features-gen/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!**/.workflow-data/**",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "!next.config.compiled.js",
        "!app/.well-known/workflow/**"
      ]
    }
  }
}
